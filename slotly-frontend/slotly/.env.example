# Slotly frontend — environment template.
#
# Copy to .env and fill in real values:  cp .env.example .env
#
# Everything here is baked into the client bundle at build time and is therefore
# public. Never put a secret in this file or in .env — only the OAuth *client
# ID*, which is designed to be public, belongs here. The matching client secret
# lives on the backend and must stay there.
#
# In production these are set in Vercel under Project Settings → Environment
# Variables. They are read during `npm run build`, so changing one requires a
# redeploy to take effect — the built files are already compiled.

# Base URL of the Slotly API, including the /api prefix and no trailing slash.
# In production this is the Render backend, e.g.
# https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth 2.0 client ID. Must be the same value as the backend's
# GOOGLE_CLIENT_ID: the frontend uses it to request an ID token, and the backend
# verifies that token was issued for this exact client. The deployed origin also
# has to be listed under the OAuth client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
