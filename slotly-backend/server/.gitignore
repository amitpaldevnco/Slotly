# Dependencies
node_modules/

# Environment variables. The template is the one file here that must be tracked —
# it is what a new developer copies to .env, and it carries no real values.
.env
.env.*
!.env.example

# Anything holding a credential, however it got there.
secrets/
*.pem
*.key
*.p12
*.pfx

# Local database files and dumps.
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump

# Uploaded images. User content, not source; regenerated by whoever uses the app.
uploads/

# Build files
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Coverage
coverage/

# Vite
.vite/

# Misc
*.local

node_modules/