# Slotly API — environment template.
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this file is the only one of the pair that is tracked, and
# it must never carry a real secret.
#
# In production none of this lives in a file: every value below is set in the
# Render dashboard under the service's Environment tab.

# --- Server ---------------------------------------------------------------
# Port the API listens on. Optional; defaults to 5000. Render sets PORT itself
# and the app must use the value it is given — do not set this on Render.
PORT=5000

# Set to "production" in a deployed environment. It switches the session cookie
# to Secure + SameSite=None, which is what lets the browser send it to an API on
# a different host from the frontend. Leaving it unset in production means
# nobody can stay signed in.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Two ways to configure this, and the connection string wins if both are set.
#
# Managed host (Neon): paste the connection string from the Neon dashboard. It
# already ends in ?sslmode=require, and TLS is enabled automatically for any
# connection string, so nothing else is needed. Set this in Render, never here.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Local development: the discrete values below. The database is created
# automatically on first boot if it does not exist, and the schema is applied on
# every start (every statement is IF NOT EXISTS).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=slotly

# Force TLS on or off. Optional; defaults to on when DATABASE_URL is set and off
# otherwise, which is right for both a managed host and a local server.
# DB_SSL=true

# --- Sessions -------------------------------------------------------------
# Signing key for the JWT held in the httpOnly session cookie. Use a long random
# string — anyone who knows this value can mint a session for any user.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value in production from the one you use locally.
JWT_SECRET=replace-me-with-a-long-random-string

# --- CORS -----------------------------------------------------------------
# Allowed browser origin(s), comma-separated, with no trailing slash. Auth is
# cookie-based, so the API sends credentials and a wildcard origin is not
# permitted. The first entry is also the base URL the GitHub OAuth callback
# redirects back to, so put the real frontend first.
# In production this is your Vercel domain, e.g. https://slotly.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Google OAuth 2.0 -----------------------------------------------------
# From the Google Cloud console. Required only for Google sign-in; the rest of
# the app runs without them. GOOGLE_CLIENT_ID must match the frontend's
# VITE_GOOGLE_CLIENT_ID, because the backend verifies the ID token against it.
# The deployed frontend origin must be added to the OAuth client's "Authorized
# JavaScript origins" or the sign-in button will not load.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- GitHub OAuth 2.0 -----------------------------------------------------
# From your GitHub OAuth app. The callback URL must match the one registered
# there exactly, including scheme and port. A GitHub OAuth app accepts only one
# callback URL, so development and production need two separate apps.
# In production: https://<your-render-service>.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
