# Dependencies
node_modules/
**/node_modules/

# Environment files. `.env.example` is the one member of this family that must
# stay tracked — it is what a new developer copies, and it carries no real value.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/

# Uploaded images. User content, not source. In production these live in
# Cloudinary; locally they are regenerated by whoever uses the app.
uploads/
**/uploads/

# Anything holding a credential, however it got there.
secrets/
*.pem
*.key
*.p12
*.pfx

# Local database files and dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
*.sql.backup

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
**/coverage/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.local
